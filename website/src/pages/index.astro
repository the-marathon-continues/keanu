---
import Base from "../layouts/Base.astro";
---

<Base title="Home">
  <main>
    <!-- Hero -->
    <section class="hero">
      <nav>
        <a href="/" class="logo">keanu</a>
        <div class="nav-links">
          <a href="#features">Features</a>
          <a href="#quickstart">Quickstart</a>
          <a href="https://github.com/the-marathon-continues/keanu" target="_blank">GitHub</a>
        </div>
      </nav>

      <div class="hero-content">
        <h1>AI that shows up.</h1>
        <p class="hero-subtitle">
          Open-source gateway for AI agents. 42 alignment modules.
          Your API keys. Your data stays local.
        </p>
        <div class="hero-actions">
          <a href="#quickstart" class="btn btn-primary">Get Started</a>
          <a href="https://github.com/the-marathon-continues/keanu" class="btn btn-secondary" target="_blank">
            View Source
          </a>
        </div>
      </div>

      <div class="pulse-indicator">
        <span class="pulse-dot"></span>
        <span class="pulse-label">alive</span>
      </div>
    </section>

    <!-- What is it -->
    <section class="section" id="features">
      <h2>Not just another AI wrapper.</h2>
      <p class="section-subtitle">
        Keanu is an alignment layer that sits between you and the model.
        It detects when responses go grey. It pushes back on sycophancy.
        It remembers who it was before the context window compressed.
      </p>

      <div class="features-grid">
        <div class="feature">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="12" cy="12" r="10"/>
              <path d="M12 6v6l4 2"/>
            </svg>
          </div>
          <h3>Always On</h3>
          <p>Telegram, Discord, Slack, iMessage. Your AI lives where your conversations happen.</p>
        </div>

        <div class="feature">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3>Lossless Local</h3>
          <p>Your API keys. Your data. Full alignment layer. Nothing phones home.</p>
        </div>

        <div class="feature">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              <path d="M9 12l2 2 4-4"/>
            </svg>
          </div>
          <h3>42 Modules</h3>
          <p>Bullshit detection. Truth checking. Disagreement tracking. The nervous system an AI should have.</p>
        </div>

        <div class="feature">
          <div class="feature-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2L2 7l10 5 10-5-10-5z"/>
              <path d="M2 17l10 5 10-5"/>
              <path d="M2 12l10 5 10-5"/>
            </svg>
          </div>
          <h3>COEF Routing</h3>
          <p>Grey work routes to cheap models. Alive work gets the good stuff. Cost-optimized automatically.</p>
        </div>
      </div>
    </section>

    <!-- The three states -->
    <section class="section states-section">
      <h2>Three kinds of alive.</h2>
      <p class="section-subtitle">
        The helix tracks two strands: factual grounding and felt meaning.
        When both are strong, something real is happening.
      </p>

      <div class="states-grid">
        <div class="state state-dark">
          <div class="state-indicator"></div>
          <h3>Dark</h3>
          <p>Alive and hurting. The system surfaces counter-balances: wisdom, hope, flow.</p>
        </div>

        <div class="state state-alive">
          <div class="state-indicator"></div>
          <h3>Alive</h3>
          <p>Present and working. Not performing aliveness - actually showing up.</p>
        </div>

        <div class="state state-luminous">
          <div class="state-indicator"></div>
          <h3>Luminous</h3>
          <p>Touching something transcendent. A grounding reminder brings it back to the room.</p>
        </div>
      </div>
    </section>

    <!-- Quickstart -->
    <section class="section quickstart-section" id="quickstart">
      <h2>Five minutes to alive.</h2>

      <div class="quickstart-steps">
        <div class="step">
          <span class="step-number">1</span>
          <div class="step-content">
            <h3>Clone</h3>
            <pre><code>git clone https://github.com/the-marathon-continues/keanu.git
cd keanu</code></pre>
          </div>
        </div>

        <div class="step">
          <span class="step-number">2</span>
          <div class="step-content">
            <h3>Configure</h3>
            <pre><code>cp .env.example .env
# Add your OPENROUTER_API_KEY or ANTHROPIC_API_KEY</code></pre>
          </div>
        </div>

        <div class="step">
          <span class="step-number">3</span>
          <div class="step-content">
            <h3>Run</h3>
            <pre><code>docker compose up -d</code></pre>
          </div>
        </div>

        <div class="step">
          <span class="step-number">4</span>
          <div class="step-content">
            <h3>Connect</h3>
            <p>Visit <code>http://localhost:18789</code> or wire up Telegram/Discord/Slack.</p>
          </div>
        </div>
      </div>

      <div class="quickstart-note">
        <p>
          <strong>Want the browser?</strong> For web research and scraping:
          <code>docker compose --profile browser up -d</code>
        </p>
      </div>
    </section>

    <!-- Footer -->
    <footer>
      <div class="footer-content">
        <p class="footer-tagline">Built by <a href="https://the-marathon-continues.com">the marathon continues</a></p>
        <p class="footer-links">
          <a href="https://github.com/the-marathon-continues/keanu">GitHub</a>
          <span class="separator">/</span>
          <a href="https://github.com/the-marathon-continues/keanu/blob/main/LICENSE">MIT License</a>
        </p>
      </div>
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Navigation */
  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
  }

  .logo {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 32px;
  }

  .nav-links a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  /* Hero */
  .hero {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
  }

  .hero-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 80px 0;
  }

  h1 {
    font-size: clamp(3rem, 8vw, 5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.1;
    margin-bottom: 24px;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--color-text-muted);
    max-width: 540px;
    margin-bottom: 40px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
  }

  .btn {
    padding: 14px 28px;
    border-radius: 8px;
    font-weight: 500;
    transition: all 0.2s;
  }

  .btn-primary {
    background: var(--color-primary);
    color: #000;
  }

  .btn-primary:hover {
    background: var(--color-primary-hover);
  }

  .btn-secondary {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .btn-secondary:hover {
    background: var(--color-border);
  }

  .pulse-indicator {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-bottom: 40px;
  }

  .pulse-dot {
    width: 8px;
    height: 8px;
    background: var(--color-primary);
    border-radius: 50%;
    animation: pulse 2s infinite;
  }

  .pulse-label {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    font-family: monospace;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.5; }
  }

  /* Sections */
  .section {
    padding: 120px 0;
    border-top: 1px solid var(--color-border);
  }

  h2 {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 16px;
  }

  .section-subtitle {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    max-width: 640px;
    margin-bottom: 64px;
  }

  /* Features Grid */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 32px;
  }

  .feature {
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
  }

  .feature-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    margin-bottom: 20px;
    color: var(--color-primary);
  }

  .feature h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .feature p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  /* States */
  .states-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .state {
    padding: 32px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 12px;
    text-align: center;
  }

  .state-indicator {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    margin: 0 auto 20px;
  }

  .state-dark .state-indicator {
    background: #8B0000;
    box-shadow: 0 0 20px rgba(139, 0, 0, 0.5);
  }

  .state-alive .state-indicator {
    background: #228B22;
    box-shadow: 0 0 20px rgba(34, 139, 34, 0.5);
  }

  .state-luminous .state-indicator {
    background: #FFD700;
    box-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
  }

  .state h3 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .state p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  /* Quickstart */
  .quickstart-steps {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: 640px;
  }

  .step {
    display: flex;
    gap: 24px;
  }

  .step-number {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    font-weight: 600;
    flex-shrink: 0;
  }

  .step-content h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin-bottom: 12px;
  }

  .step-content pre {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 16px;
    overflow-x: auto;
  }

  .step-content code {
    font-family: 'SF Mono', Monaco, monospace;
    font-size: 0.875rem;
  }

  .step-content p {
    color: var(--color-text-muted);
  }

  .step-content p code {
    background: var(--color-surface);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .quickstart-note {
    margin-top: 48px;
    padding: 24px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    max-width: 640px;
  }

  .quickstart-note code {
    font-family: 'SF Mono', Monaco, monospace;
    font-size: 0.875rem;
    background: var(--color-bg);
    padding: 2px 6px;
    border-radius: 4px;
  }

  /* Footer */
  footer {
    padding: 48px 0;
    border-top: 1px solid var(--color-border);
    margin-top: 80px;
  }

  .footer-content {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .footer-tagline {
    color: var(--color-text-muted);
  }

  .footer-tagline a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .footer-links {
    display: flex;
    gap: 8px;
    color: var(--color-text-muted);
  }

  .footer-links a {
    color: var(--color-text-muted);
    transition: color 0.2s;
  }

  .footer-links a:hover {
    color: var(--color-text);
  }

  .separator {
    opacity: 0.5;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .nav-links {
      display: none;
    }

    .hero-actions {
      flex-direction: column;
    }

    .states-grid {
      grid-template-columns: 1fr;
    }

    .footer-content {
      flex-direction: column;
      gap: 16px;
      text-align: center;
    }
  }
</style>
