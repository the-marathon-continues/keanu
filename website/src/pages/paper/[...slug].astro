---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const papers = await getCollection("paper");
  return papers.map((paper) => ({
    params: { slug: paper.slug },
    props: { paper },
  }));
}

interface Props {
  paper: CollectionEntry<"paper">;
}

const { paper } = Astro.props;
const { Content } = await paper.render();

// Get all papers for navigation
const allPapers = await getCollection("paper");
const sortedPapers = allPapers.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const currentIndex = sortedPapers.findIndex((p) => p.slug === paper.slug);
const prevPaper = currentIndex > 0 ? sortedPapers[currentIndex - 1] : null;
const nextPaper = currentIndex < sortedPapers.length - 1 ? sortedPapers[currentIndex + 1] : null;
---

<Base title={paper.data.title ?? "Paper"}>
  <main>
    <header>
      <nav>
        <a href="/" class="logo">keanu</a>
        <div class="nav-links">
          <a href="/#toc">Contents</a>
          <a href="https://github.com/the-marathon-continues/keanu">GitHub</a>
        </div>
      </nav>
    </header>

    <article class="paper">
      <Content />
    </article>

    <nav class="paper-nav">
      {prevPaper ? (
        <a href={`/paper/${prevPaper.slug}`} class="nav-prev">
          <span class="nav-label">Previous</span>
          <span class="nav-title">{prevPaper.data.title}</span>
        </a>
      ) : <div />}

      {nextPaper ? (
        <a href={`/paper/${nextPaper.slug}`} class="nav-next">
          <span class="nav-label">Next</span>
          <span class="nav-title">{nextPaper.data.title}</span>
        </a>
      ) : (
        <a href="/" class="nav-next">
          <span class="nav-label">Return to</span>
          <span class="nav-title">Home</span>
        </a>
      )}
    </nav>

    <footer>
      <p>Built by <a href="https://the-marathon-continues.com">the marathon continues</a></p>
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  header {
    padding: 24px 0;
    margin-bottom: 48px;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 24px;
  }

  .nav-links a {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  /* Paper content styles */
  .paper {
    margin-bottom: 80px;
  }

  .paper :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
    line-height: 1.3;
  }

  .paper :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 64px;
    margin-bottom: 24px;
    line-height: 1.3;
  }

  .paper :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .paper :global(p) {
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .paper :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .paper :global(em) {
    font-style: italic;
  }

  .paper :global(blockquote) {
    margin: 32px 0;
    padding-left: 24px;
    border-left: 3px solid var(--color-primary);
    color: var(--color-text);
    font-style: italic;
  }

  .paper :global(ul),
  .paper :global(ol) {
    color: var(--color-text-muted);
    margin-bottom: 24px;
    padding-left: 24px;
    line-height: 1.8;
  }

  .paper :global(li) {
    margin-bottom: 8px;
  }

  .paper :global(code) {
    font-family: 'SF Mono', Monaco, monospace;
    font-size: 0.875em;
    background: var(--color-surface);
    padding: 2px 6px;
    border-radius: 4px;
  }

  .paper :global(pre) {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 20px;
    overflow-x: auto;
    margin-bottom: 24px;
  }

  .paper :global(pre code) {
    background: none;
    padding: 0;
  }

  .paper :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 24px;
  }

  .paper :global(th),
  .paper :global(td) {
    text-align: left;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
  }

  .paper :global(th) {
    font-weight: 600;
    font-size: 0.875rem;
  }

  .paper :global(td) {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  .paper :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .paper :global(a:hover) {
    color: var(--color-primary-hover);
  }

  /* Paper navigation */
  .paper-nav {
    display: flex;
    justify-content: space-between;
    padding: 32px 0;
    border-top: 1px solid var(--color-border);
    margin-bottom: 48px;
  }

  .nav-prev,
  .nav-next {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 45%;
  }

  .nav-next {
    align-items: flex-end;
    text-align: right;
  }

  .nav-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .nav-title {
    color: var(--color-text);
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-prev:hover .nav-title,
  .nav-next:hover .nav-title {
    color: var(--color-primary);
  }

  footer {
    padding: 48px 0;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  footer a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
