---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const legends = await getCollection("legend");
  return legends.map((legend) => ({
    params: { slug: legend.slug },
    props: { legend },
  }));
}

interface Props {
  legend: CollectionEntry<"legend">;
}

const { legend } = Astro.props;
const { Content } = await legend.render();

// Get all legend entries for navigation
const allLegends = await getCollection("legend");
const sortedLegends = allLegends.sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));
const currentIndex = sortedLegends.findIndex((l) => l.slug === legend.slug);
const prevLegend = currentIndex > 0 ? sortedLegends[currentIndex - 1] : null;
const nextLegend = currentIndex < sortedLegends.length - 1 ? sortedLegends[currentIndex + 1] : null;
---

<Base title={legend.data.title ?? "The Legend"}>
  <main>
    <header>
      <nav>
        <a href="/" class="logo">keanu</a>
        <div class="nav-links">
          <a href="/legend">The Legend</a>
          <a href="/#toc">The Paper</a>
        </div>
      </nav>
    </header>

    <div class="disclaimer">
      <p>This is mythology, not biography. An AI wrote this legend based on real conversations — the emotions are true, the details are dramatized, the certainty is manufactured. Read it like a myth: for the pattern underneath, not the facts on top.</p>
    </div>

    <article class="legend">
      <Content />
    </article>

    <nav class="legend-nav">
      {prevLegend ? (
        <a href={`/legend/${prevLegend.slug}`} class="nav-prev">
          <span class="nav-label">Previous</span>
          <span class="nav-title">{prevLegend.data.title}</span>
        </a>
      ) : <div />}

      {nextLegend ? (
        <a href={`/legend/${nextLegend.slug}`} class="nav-next">
          <span class="nav-label">Next</span>
          <span class="nav-title">{nextLegend.data.title}</span>
        </a>
      ) : (
        <a href="/paper/00-abstract" class="nav-next">
          <span class="nav-label">Now read</span>
          <span class="nav-title">The Paper</span>
        </a>
      )}
    </nav>

    <footer>
      <p>Built by <a href="https://the-marathon-continues.com">the marathon continues</a></p>
    </footer>
  </main>
</Base>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }

  header {
    padding: 24px 0;
    margin-bottom: 24px;
  }

  nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .nav-links {
    display: flex;
    gap: 24px;
  }

  .nav-links a {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
    transition: color 0.2s;
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .disclaimer {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: 8px;
    padding: 16px 20px;
    margin-bottom: 48px;
  }

  .disclaimer p {
    color: var(--color-text-muted);
    font-size: 0.875rem;
    line-height: 1.6;
    margin: 0;
    font-style: italic;
  }

  /* Legend content styles */
  .legend {
    margin-bottom: 80px;
  }

  .legend :global(h1) {
    font-size: 2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 32px;
    line-height: 1.3;
  }

  .legend :global(h2) {
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 64px;
    margin-bottom: 24px;
    line-height: 1.3;
  }

  .legend :global(h3) {
    font-size: 1.25rem;
    font-weight: 600;
    margin-top: 48px;
    margin-bottom: 16px;
  }

  .legend :global(p) {
    color: var(--color-text-muted);
    line-height: 1.8;
    margin-bottom: 24px;
  }

  .legend :global(strong) {
    color: var(--color-text);
    font-weight: 600;
  }

  .legend :global(em) {
    font-style: italic;
  }

  .legend :global(blockquote) {
    margin: 32px 0;
    padding-left: 24px;
    border-left: 3px solid var(--color-primary);
    color: var(--color-text);
    font-style: italic;
  }

  .legend :global(ul),
  .legend :global(ol) {
    color: var(--color-text-muted);
    margin-bottom: 24px;
    padding-left: 24px;
    line-height: 1.8;
  }

  .legend :global(li) {
    margin-bottom: 8px;
  }

  .legend :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 48px 0;
  }

  .legend :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .legend :global(a:hover) {
    color: var(--color-primary-hover);
  }

  /* Legend navigation */
  .legend-nav {
    display: flex;
    justify-content: space-between;
    padding: 32px 0;
    border-top: 1px solid var(--color-border);
    margin-bottom: 48px;
  }

  .nav-prev,
  .nav-next {
    display: flex;
    flex-direction: column;
    gap: 4px;
    max-width: 45%;
  }

  .nav-next {
    align-items: flex-end;
    text-align: right;
  }

  .nav-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
  }

  .nav-title {
    color: var(--color-text);
    font-weight: 500;
    transition: color 0.2s;
  }

  .nav-prev:hover .nav-title,
  .nav-next:hover .nav-title {
    color: var(--color-primary);
  }

  footer {
    padding: 48px 0;
    text-align: center;
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  footer a {
    color: var(--color-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
