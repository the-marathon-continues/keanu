{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "pulse.ts",
    "bullshit.ts",
    "signal.ts",
    "human.ts",
    "nudge.ts",
    "truth.ts",
    "reflexion.ts",
    "disagreement.ts",
    "state.ts",
    "types.ts",
    "breathe.ts",
    "health.ts",
    "mastery.ts",
    "introspect.ts",
    "calibrate.ts",
    "mismatch.ts",
    "chain.ts",
    "injection.ts",
    "observe.ts",
    "metrics.ts",
    "gymnasium/harness.ts",
    "gymnasium/scorecard.ts",
    "gymnasium/types.ts",
    "package-entry.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "convergence/**",
    "a2a-server/**",
    "tools.ts",
    "index.ts"
  ]
}
