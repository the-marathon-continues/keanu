{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["DOM", "DOM.Iterable", "ES2023", "ScriptHost"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "noEmitOnError": true,
    "outDir": "dist",
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2023",
    "useDefineForClassFields": false,
    "paths": {
      "keanu/plugin-sdk": ["./src/plugin-sdk/index.ts"],
      "keanu/plugin-sdk/*": ["./src/plugin-sdk/*.ts"],
      "keanu/plugin-sdk/account-id": ["./src/plugin-sdk/account-id.ts"]
    }
  },
  "include": ["src/**/*", "ui/**/*", "extensions/**/*", "keanu-core/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "extensions/keanu/a2a-server/**",
    "extensions/keanu/research-extension/**",
    "keanu-core/gymnasium/**",
    "keanu-core/problem-sets/**",
    "keanu-core/shared/debug-coef.ts",
    "keanu-core/test-pulse-accuracy.ts",
    "keanu-core/layer-3-causal/nli.ts"
  ]
}
