# Keanu .env — lossless local deployment
#
# Copy to .env and fill in your keys.
# All 42 modules. Full persistence. Your data stays local.
#
# Mirrors: silverado/infra/keanu/task_definition.tf

# =============================================================================
# REQUIRED — API keys (at least one)
# =============================================================================

# OpenRouter recommended — COEF routes to optimal model per task
OPENROUTER_API_KEY=sk-or-...

# Or direct provider keys
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# =============================================================================
# IDENTITY
# =============================================================================

# Your user ID (creates ~/.keanu/agents/{user}/awareness/ for persistence)
KEANU_USER_ID=local

# =============================================================================
# OPTIONAL — headless browser for research
# =============================================================================

# Enable browser (local or sidecar)
KEANU_BROWSER_ENABLED=false

# Run headless (no GUI) — ideal for containers/servers
KEANU_BROWSER_HEADLESS=true

# CDP endpoint (for sidecar containers like browserless/chrome)
# KEANU_BROWSER_CDP_URL=http://localhost:9222

# Attach-only mode (don't launch Chrome, just connect to existing)
# KEANU_BROWSER_ATTACH_ONLY=true

# =============================================================================
# OPTIONAL — git-sync for cross-session memory
# =============================================================================

# Push awareness to your own repo (private recommended)
# KEANU_MEMORY_REPO=your-username/keanu-memory
# KEANU_MEMORY_TOKEN=ghp_...
# KEANU_MEMORY_BRANCH=main

# =============================================================================
# OPTIONAL — channels
# =============================================================================

# TELEGRAM_BOT_TOKEN=123456:ABCDEF...
# DISCORD_BOT_TOKEN=...
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# =============================================================================
# OPTIONAL — gateway auth (recommended if binding beyond localhost)
# =============================================================================

# OPENCLAW_GATEWAY_TOKEN=change-me-to-a-long-random-token

# =============================================================================
# PATHS (usually don't need to change)
# =============================================================================

# OPENCLAW_CONFIG_DIR=~/.openclaw
# KEANU_PORT=18789
# BROWSER_PORT=9222
